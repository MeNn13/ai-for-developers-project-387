{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/glm-5.3-flash-free",
  "default_agent": "discussion",
  "share": "disabled",
  "snapshots": false,
  "formatter": false,
  "lsp": false,
  "compaction": { "auto": false },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "deny" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" }
  ],
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "opencode", "effect": "allow" },
    { "action": "integration.use", "resource": "mcp:*", "effect": "deny" },
    { "action": "tool.use", "resource": "*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*", "effect": "allow" },
    { "action": "tool.use", "resource": "glob:*", "effect": "allow" },
    { "action": "tool.use", "resource": "grep:*", "effect": "allow" },
    { "action": "tool.use", "resource": "skill:*", "effect": "allow" }
  ],
  "agents": {
    "discussion": {
      "mode": "primary",
      "model": "opencode/glm-5.3-flash-free",
      "description": "Read repository instructions and answer GitHub discussions",
      "steps": 20
    },
    "title": { "model": "opencode/glm-5.3-flash-free" },
    "summary": { "model": "opencode/glm-5.3-flash-free" },
    "compaction": { "model": "opencode/glm-5.3-flash-free" }
  }
}
